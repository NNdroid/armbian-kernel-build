_kernel_inject_enable_bpf_lsm_order() {
	local config_file="$1"
	local current_lsm
	local updated_lsm
	local temporary="${config_file}.inject.$$"

	current_lsm="$(sed -n 's/^CONFIG_LSM="\([^"]*\)"$/\1/p' "${config_file}")"
	if [[ -z "${current_lsm}" ]]; then
		_kernel_inject_log err "Incomplete eBPF configuration" \
			"CONFIG_LSM is missing from ${config_file}; BPF LSM cannot be activated"
		return 1
	fi

	case ",${current_lsm}," in
		*,bpf,*) return 0 ;;
	esac

	updated_lsm="${current_lsm},bpf"
	if [[ -x ./scripts/config ]]; then
		if declare -F run_host_command_logged >/dev/null 2>&1; then
			run_host_command_logged ./scripts/config --set-val LSM "\"${updated_lsm}\""
		else
			./scripts/config --set-val LSM "\"${updated_lsm}\""
		fi
		return 0
	fi

	# Test/fallback path for environments that source this hook without the
	# Armbian config helpers. Replace exactly one CONFIG_LSM assignment.
	awk -v replacement="CONFIG_LSM=\"${updated_lsm}\"" '
		/^CONFIG_LSM=/ && !replaced { print replacement; replaced = 1; next }
		{ print }
		END { if (!replaced) exit 42 }
	' "${config_file}" > "${temporary}" || {
		rm -f -- "${temporary}"
		_kernel_inject_log err "Incomplete eBPF configuration" \
			"Could not add bpf to CONFIG_LSM in ${config_file}"
		return 1
	}
	mv -- "${temporary}" "${config_file}"
}

_kernel_inject_enable_full_ebpf() {
	local -a ebpf_y=()
	local -a ebpf_m=()

	mapfile -t ebpf_y < <(_kernel_inject_full_ebpf_y_options)
	mapfile -t ebpf_m < <(_kernel_inject_full_ebpf_m_options)
	opts_n+=(DEBUG_INFO_NONE DEBUG_INFO_REDUCED)
	opts_y+=("${ebpf_y[@]}")
	opts_m+=("${ebpf_m[@]}")
	kernel_config_modifying_hashes+=("full-ebpf-btf-core-v1" "bpf-lsm-runtime-order-v1")

	# CONFIG_BPF_LSM only compiles the LSM. It also has to appear in the
	# ordered CONFIG_LSM string to be initialized at boot.
	[[ -f .config ]] || return 0
	_kernel_inject_enable_bpf_lsm_order .config
}

_kernel_inject_enable_full_networking() {
	local -a network_y=()
	local -a network_prefer_y=()
	local -a network_m=()

	mapfile -t network_y < <(_kernel_inject_full_network_y_options)
	mapfile -t network_prefer_y < <(_kernel_inject_full_network_prefer_y_options)
	mapfile -t network_m < <(_kernel_inject_full_network_m_options)
	opts_y+=("${network_y[@]}" "${network_prefer_y[@]}")
	opts_m+=("${network_m[@]}")
	kernel_config_modifying_hashes+=("full-networking-v2")
}

# ============================================================================
# 内核树已定义符号扫描
#
# 强制校验清单是硬编码的，而符号会随内核版本增删改名。用 Kconfig 实际定义的
# 扫描目标内核树的实际 Kconfig 符号。完整功能清单中的正向能力必须严格存在并
# 通过最终 .config 校验；只有明确属于“关闭旧调试模式”的兼容检查允许按版本跳过。
# ============================================================================
_KERNEL_INJECT_DEFINED_SYMBOLS_FILE=""
_KERNEL_INJECT_DEFINED_SYMBOLS_ROOT=""

_kernel_inject_scan_defined_symbols() {
	local kernel_root="$1"

	find "${kernel_root}" -name 'Kconfig*' -type f -print0 2>/dev/null |
		xargs -0 -r grep -hE '^[[:space:]]*(config|menuconfig)[[:space:]]+[A-Z0-9_]+' 2>/dev/null |
		awk '{print $2}' | sort -u
}

_kernel_inject_kbuild_arch() {
	local armbian_arch="$1"

	case "${armbian_arch}" in
		amd64 | x86_64 | x86) printf 'x86\n' ;;
		arm64 | aarch64) printf 'arm64\n' ;;
		armhf | arm) printf 'arm\n' ;;
		riscv64 | riscv) printf 'riscv\n' ;;
		loong64 | loongarch) printf 'loongarch\n' ;;
		*) printf '%s\n' "${armbian_arch}" ;;
	esac
}

_kernel_inject_revision_commit() {
	local revision_file="$1"

	sed -n 's/^commit=//p' "${revision_file}" 2>/dev/null | head -n 1
}

_kernel_inject_cleanup_symbol_cache() {
	if [[ -n "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" ]]; then
		rm -f -- "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}"
	fi
	_KERNEL_INJECT_DEFINED_SYMBOLS_FILE=""
	_KERNEL_INJECT_DEFINED_SYMBOLS_ROOT=""
}

_kernel_inject_load_defined_symbols() {
	local kernel_root="$1"
	local count

	if [[ -n "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" && \
		"${_KERNEL_INJECT_DEFINED_SYMBOLS_ROOT}" == "${kernel_root}" && \
		-s "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" ]]; then
		return 0
	fi

	_kernel_inject_cleanup_symbol_cache
	_KERNEL_INJECT_DEFINED_SYMBOLS_ROOT="${kernel_root}"
	_KERNEL_INJECT_DEFINED_SYMBOLS_FILE="$(mktemp "${TMPDIR:-/tmp}/kernel-inject-defined-symbols.XXXXXX")"
	if ! _kernel_inject_scan_defined_symbols "${kernel_root}" > "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}"; then
		_kernel_inject_log warn "Kconfig 扫描失败" "无法在 ${kernel_root} 收集已定义符号"
		_kernel_inject_cleanup_symbol_cache
		return 1
	fi
	count="$(wc -l < "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" | tr -d ' ')"
	_kernel_inject_log debug "Kconfig 符号扫描" \
		"${kernel_root}: ${count} 个已定义符号"
	return 0
}

_kernel_inject_symbol_is_defined() {
	local symbol="$1"

	[[ -n "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" && \
		-s "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" ]] || return 1
	grep -qx "${symbol}" "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}"
}

# 符号表是否可用（扫描成功且非空）。不可用时应退回严格校验。
_kernel_inject_symbol_scan_available() {
	[[ -n "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" && \
		-s "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" ]]
}

# 内部工具: 按清单严格校验符号。清单中的能力如果在目标内核树中未定义，说明
# 该内核无法提供承诺的完整功能，必须失败，不能静默生成一个功能缩水的 Release。
# $1 = config 文件, $2 = 期望值的正则片段 ("y" 或 "[ym]"), $3 = 符号数组名
_kernel_inject_verify_symbol_list() {
	local config_file="$1"
	local wanted_pattern="$2"
	local array_name="$3"
	local symbol
	local -n required_symbols="${array_name}"
	local -a missing=()
	local actual
	local symbols_available=yes

	if ! _kernel_inject_load_defined_symbols "$(dirname "${config_file}")"; then
		symbols_available=no
	fi
	if [[ "${symbols_available}" == yes && ! -s "${_KERNEL_INJECT_DEFINED_SYMBOLS_FILE}" ]]; then
		_kernel_inject_log warn "Kconfig 扫描为空" \
			"$(dirname "${config_file}") 下没有 Kconfig 文件；按严格模式校验全部符号"
		symbols_available=no
	fi

	for symbol in "${required_symbols[@]}"; do
		if [[ "${symbols_available}" == yes ]] && \
			! _kernel_inject_symbol_is_defined "${symbol}"; then
			missing+=("CONFIG_${symbol}=${wanted_pattern}(undefined)")
			continue
		fi
		if ! grep -Eq "^CONFIG_${symbol}=${wanted_pattern}$" "${config_file}"; then
			actual="$(sed -n "s/^CONFIG_${symbol}=//p" "${config_file}" | tail -n 1)"
			if [[ -z "${actual}" ]] && grep -qx "# CONFIG_${symbol} is not set" "${config_file}"; then
				actual=n
			fi
			missing+=("CONFIG_${symbol}=${wanted_pattern}(actual=${actual:-<missing>})")
		fi
	done

	if ((${#missing[@]} > 0)); then
		KERNEL_INJECT_MISSING_SYMBOLS=("${missing[@]}")
		return 1
	fi
	_kernel_inject_log debug "符号校验" \
		"清单 ${array_name}: ${#required_symbols[@]} 个符号 (= ${wanted_pattern}) 校验通过"
	return 0
}

_kernel_inject_verify_full_ebpf_config() {
	local config_file="$1"
	local lsm_order
	local symbol
	local -a required_y=()
	local -a required_enabled=()

	if [[ ! -f "${config_file}" ]]; then
		_kernel_inject_log err "eBPF verification failed" "Missing kernel config: ${config_file}"
		return 1
	fi

	# 先就绪符号表（verify_symbol_list 也会加载，这里是缓存命中）。
	_kernel_inject_load_defined_symbols "$(dirname "${config_file}")" || true

	mapfile -t required_y < <(_kernel_inject_full_ebpf_y_options)
	# HAVE_EBPF_JIT is selected by the architecture rather than set directly.
	required_y+=(HAVE_EBPF_JIT)
	mapfile -t required_enabled < <(_kernel_inject_full_ebpf_m_options)

	if ! _kernel_inject_verify_symbol_list "${config_file}" y required_y; then
		_kernel_inject_log err "eBPF verification failed" \
			"${config_file} does not satisfy: ${KERNEL_INJECT_MISSING_SYMBOLS[*]}"
		return 1
	fi
	if ! _kernel_inject_verify_symbol_list "${config_file}" '[ym]' required_enabled; then
		_kernel_inject_log err "eBPF verification failed" \
			"${config_file} does not satisfy: ${KERNEL_INJECT_MISSING_SYMBOLS[*]}"
		return 1
	fi
	for symbol in DEBUG_INFO_NONE DEBUG_INFO_REDUCED; do
		if _kernel_inject_symbol_scan_available && \
			! _kernel_inject_symbol_is_defined "${symbol}"; then
			_kernel_inject_log warn "兼容性检查" \
				"当前内核树未定义 CONFIG_${symbol}，无需检查该旧调试模式是否关闭"
			_kernel_inject_skipped_symbols+=("${symbol}")
			continue
		fi
		grep -qx "# CONFIG_${symbol} is not set" "${config_file}" || {
			_kernel_inject_log err "eBPF verification failed" \
				"${config_file}: CONFIG_${symbol} must be off"
			return 1
		}
	done

	lsm_order="$(sed -n 's/^CONFIG_LSM="\([^"]*\)"$/\1/p' "${config_file}")"
	case ",${lsm_order}," in
		*,bpf,*) ;;
		*)
			_kernel_inject_log err "eBPF verification failed" \
				"${config_file}: CONFIG_LSM does not contain bpf (current: ${lsm_order:-<empty>})"
			return 1
			;;
	esac

	_kernel_inject_log info "Full eBPF verification" \
		"Core/JIT(${#required_y[@]} symbols), modules(${#required_enabled[@]} symbols), BTF/CO-RE, cgroup/LSM, XDP/tc and tracing verified in ${config_file}"
}

_kernel_inject_verify_full_network_config() {
	local config_file="$1"
	local -a required_y=()
	local -a preferred_y=()
	local -a required_enabled=()

	if [[ ! -f "${config_file}" ]]; then
		_kernel_inject_log err "Network feature verification failed" \
			"Missing kernel config: ${config_file}"
		return 1
	fi

	mapfile -t required_y < <(_kernel_inject_full_network_y_options)
	mapfile -t preferred_y < <(_kernel_inject_full_network_prefer_y_options)
	mapfile -t required_enabled < <(_kernel_inject_full_network_m_options)
	required_enabled+=("${preferred_y[@]}")
	# Native WireGuard keeps its existing y/m override while the complete
	# networking profile requires that one of those modes survives olddefconfig.
	required_enabled+=(WIREGUARD)

	if ! _kernel_inject_verify_symbol_list "${config_file}" y required_y; then
		_kernel_inject_log err "Network feature verification failed" \
			"${config_file} does not satisfy: ${KERNEL_INJECT_MISSING_SYMBOLS[*]}"
		return 1
	fi
	if ! _kernel_inject_verify_symbol_list "${config_file}" '[ym]' required_enabled; then
		_kernel_inject_log err "Network feature verification failed" \
			"${config_file} does not satisfy: ${KERNEL_INJECT_MISSING_SYMBOLS[*]}"
		return 1
	fi

	_kernel_inject_log info "Full network feature verification" \
		"MPLS/SRv6, VXLAN/Geneve/GRE/FOU, WireGuard, netfilter/nftables, BBR, bridge/BNEP and USB Gadget verified in ${config_file} (y=${#required_y[@]}, y|m=${#required_enabled[@]} symbols)"
}

_kernel_inject_fetch() {
	local repository="$1"
	local ref="$2"
	local expected_commit="$3"
	local destination="$4"
	local actual_commit
	local attempt
	local fetched=no

	if [[ ! "${expected_commit}" =~ ^[0-9a-f]{40}$ ]]; then
		_kernel_inject_log err "Invalid source pin" \
			"Expected a full lowercase commit SHA for ${repository}, got '${expected_commit}'"
		return 1
	fi

	git init --quiet "${destination}"
	git -C "${destination}" remote add origin "${repository}"
	for attempt in 1 2 3 4; do
		if GIT_TERMINAL_PROMPT=0 git -C "${destination}" -c protocol.version=2 \
			fetch --quiet --depth 1 origin "${ref}"; then
			_kernel_inject_log debug "Source download" \
				"attempt ${attempt}/4 ok: ${repository}@${ref}"
			fetched=yes
			break
		fi
		_kernel_inject_log warn "Source download retry" \
			"attempt ${attempt}/4 failed for ${repository}@${ref}"
		((attempt < 4)) && sleep $((attempt * attempt))
	done
	if [[ "${fetched}" != yes ]]; then
		_kernel_inject_log err "Source download failed" \
			"Could not fetch ${repository}@${ref} after 4 attempts"
		return 1
	fi
	git -C "${destination}" -c advice.detachedHead=false checkout --quiet --detach FETCH_HEAD
	actual_commit="$(git -C "${destination}" rev-parse HEAD)"

	if [[ "${actual_commit}" != "${expected_commit}" ]]; then
		_kernel_inject_log err "Source verification failed" \
			"${repository}@${ref} resolved to ${actual_commit}, expected ${expected_commit}"
		return 1
	fi

	printf '%s\n' "${actual_commit}"
}

_kernel_inject_require_files() {
	local source_dir="$1"
	shift
	local relative_path

	for relative_path in "$@"; do
		if [[ ! -f "${source_dir}/${relative_path}" ]]; then
			_kernel_inject_log err "Invalid upstream layout" "Missing ${relative_path} in ${source_dir}"
			return 1
		fi
	done
}

_kernel_inject_assert_child_path() {
	local kernel_root="$1"
	local candidate="$2"

	case "${candidate}" in
		"${kernel_root}"/*) return 0 ;;
		*)
			_kernel_inject_log err "Unsafe path" "Refusing to modify path outside ${kernel_root}: ${candidate}"
			return 1
			;;
	esac
}

_kernel_inject_activate_dir() {
	local kernel_root="$1"
	local staging_dir="$2"
	local destination="$3"
	local backup="${destination}.old.$$"

	_kernel_inject_assert_child_path "${kernel_root}" "${staging_dir}"
	_kernel_inject_assert_child_path "${kernel_root}" "${destination}"
	_kernel_inject_assert_child_path "${kernel_root}" "${backup}"

	rm -rf -- "${backup}"
	if [[ -e "${destination}" || -L "${destination}" ]]; then
		mv -- "${destination}" "${backup}"
	fi

	if mv -- "${staging_dir}" "${destination}"; then
		rm -rf -- "${backup}"
		return 0
	fi

	if [[ -e "${backup}" || -L "${backup}" ]]; then
		mv -- "${backup}" "${destination}"
	fi
	return 1
}

_kernel_inject_remove_exact_line() {
	local file="$1"
	local target_line="$2"
	local temporary="${file}.inject.$$"

	awk -v target="${target_line}" '$0 != target { print }' "${file}" > "${temporary}"
	mv -- "${temporary}" "${file}"
}

_kernel_inject_remove_legacy_stanza() {
	local file="$1"
	local symbol="$2"
	local temporary="${file}.inject.$$"

	awk -v start="config ${symbol}" '
		$0 == start { skipping = 1; next }
		skipping && $0 ~ /^[^[:space:]]/ { skipping = 0 }
		!skipping { print }
	' "${file}" > "${temporary}"
	mv -- "${temporary}" "${file}"
}

_kernel_inject_remove_legacy_tcp_patch() {
	local tcp_c="$1"
	local temporary="${tcp_c}.inject.$$"

	awk '
		index($0, "--- 新增: TCP Brutal 专属") { skipping = 1; next }
		skipping && index($0, "-------------------------------------------") { skipping = 0; next }
		!skipping { print }
		END { if (skipping) exit 42 }
	' "${tcp_c}" > "${temporary}" || {
		rm -f -- "${temporary}"
		_kernel_inject_log err "Legacy cleanup failed" "Unterminated TCP-Brutal marker in ${tcp_c}"
		return 1
	}
	mv -- "${temporary}" "${tcp_c}"
}

_kernel_inject_replace_block() {
	local file="$1"
	local marker="$2"
	local body="$3"
	local begin="# BEGIN ARMBIAN-KERNEL-INJECT: ${marker}"
	local end="# END ARMBIAN-KERNEL-INJECT: ${marker}"
	local temporary="${file}.inject.$$"

	awk -v begin="${begin}" -v end="${end}" '
		$0 == begin { skipping = 1; next }
		$0 == end {
			if (!skipping) exit 43
			skipping = 0
			next
		}
		!skipping {
			if ($0 == "") { blanks++; next }
			while (blanks > 0) { print ""; blanks-- }
			print
		}
		END { if (skipping) exit 42 }
	' "${file}" > "${temporary}" || {
		rm -f -- "${temporary}"
		_kernel_inject_log err "Marker update failed" "Malformed ${marker} marker in ${file}"
		return 1
	}

	{
		cat "${temporary}"
		printf '\n%s\n%s\n%s\n' "${begin}" "${body}" "${end}"
	} > "${temporary}.new"
	mv -- "${temporary}.new" "${file}"
	rm -f -- "${temporary}"
}

_kernel_inject_tcp_brutal() {
	local kernel_root="$1"
	local checkout="$2"
	local repository="$3"
	local ref="$4"
	local expected_commit="$5"
	local actual_commit
	local destination="${kernel_root}/net/ipv4/tcp_brutal"
	local staging

	actual_commit="$(_kernel_inject_fetch "${repository}" "${ref}" "${expected_commit}" "${checkout}")"
	_kernel_inject_log debug "TCP-Brutal v2" "来源 ${repository}@${ref} -> ${actual_commit:0:12}"
	_kernel_inject_require_files "${checkout}" \
		brutal.h brutal_cc.c brutal_sockopt.c brutal_rules.c Makefile LICENSE

	staging="$(mktemp -d "${kernel_root}/net/ipv4/.tcp_brutal.new.XXXXXX")"
	cp -a -- "${checkout}/brutal.h" "${checkout}/brutal_cc.c" \
		"${checkout}/brutal_sockopt.c" "${checkout}/brutal_rules.c" \
		"${checkout}/LICENSE" "${staging}/"

	cat > "${staging}/Makefile" <<'TCP_BRUTAL_KBUILD'
# SPDX-License-Identifier: GPL-3.0-only
obj-$(CONFIG_TCP_CONG_BRUTAL) += brutal.o
brutal-y := brutal_cc.o brutal_sockopt.o brutal_rules.o

ccflags-y += -std=gnu99

# BBRv3-derived kernels replace min_tso_segs with tso_segs. There is no
# version macro for this API, so detect the actual target kernel header.
TCP_BRUTAL_TCP_H := $(srctree)/include/net/tcp.h
ifneq ($(shell grep -Eq '\(\*tso_segs\)\(struct sock \*sk, unsigned int mss_now\)' $(TCP_BRUTAL_TCP_H) 2>/dev/null && echo y),)
ccflags-y += -DBRUTAL_HAVE_TSO_SEGS
endif
TCP_BRUTAL_KBUILD

	cat > "${staging}/Kconfig" <<'TCP_BRUTAL_KCONFIG'
config TCP_CONG_BRUTAL
	tristate "TCP Brutal v2 congestion control"
	depends on INET && PROC_FS
	help
	  TCP Brutal is Hysteria's fixed-rate TCP congestion control.
	  Version 2 provides per-destination rules and connection groups.
TCP_BRUTAL_KCONFIG

	{
		printf 'repository=%s\n' "${repository}"
		printf 'ref=%s\n' "${ref}"
		printf 'commit=%s\n' "${actual_commit}"
	} > "${staging}/.source-revision"

	_kernel_inject_activate_dir "${kernel_root}" "${staging}" "${destination}"

	rm -f -- "${kernel_root}/net/ipv4/tcp_brutal.c"
	_kernel_inject_remove_exact_line "${kernel_root}/net/ipv4/Makefile" \
		'obj-$(CONFIG_TCP_CONG_BRUTAL) += tcp_brutal.o'
	_kernel_inject_remove_legacy_stanza "${kernel_root}/net/ipv4/Kconfig" TCP_CONG_BRUTAL
	_kernel_inject_remove_legacy_tcp_patch "${kernel_root}/net/ipv4/tcp.c"
	_kernel_inject_replace_block "${kernel_root}/net/ipv4/Kconfig" TCP_BRUTAL_V2 \
		'source "net/ipv4/tcp_brutal/Kconfig"'
	_kernel_inject_replace_block "${kernel_root}/net/ipv4/Makefile" TCP_BRUTAL_V2 \
		'obj-$(CONFIG_TCP_CONG_BRUTAL) += tcp_brutal/'

	_kernel_inject_log info "TCP-Brutal v2" "Injected ${actual_commit}"
}

_kernel_inject_amneziawg() {
	local kernel_root="$1"
	local checkout="$2"
	local repository="$3"
	local ref="$4"
	local expected_commit="$5"
	local actual_commit
	local destination="${kernel_root}/drivers/net/amneziawg"
	local staging

	actual_commit="$(_kernel_inject_fetch "${repository}" "${ref}" "${expected_commit}" "${checkout}")"
	_kernel_inject_log debug "AmneziaWG" "来源 ${repository}@${ref} -> ${actual_commit:0:12}"
	_kernel_inject_require_files "${checkout}/src" Kbuild Kconfig main.c compat/Kbuild.include

	staging="$(mktemp -d "${kernel_root}/drivers/net/.amneziawg.new.XXXXXX")"
	cp -a -- "${checkout}/src/." "${staging}/"
	cp -a -- "${checkout}/COPYING" "${staging}/"
	{
		printf 'repository=%s\n' "${repository}"
		printf 'ref=%s\n' "${ref}"
		printf 'commit=%s\n' "${actual_commit}"
	} > "${staging}/.source-revision"

	_kernel_inject_activate_dir "${kernel_root}" "${staging}" "${destination}"
	_kernel_inject_remove_exact_line "${kernel_root}/drivers/net/Kconfig" \
		'source "drivers/net/amneziawg/Kconfig"'
	_kernel_inject_remove_exact_line "${kernel_root}/drivers/net/Makefile" \
		'obj-$(CONFIG_AMNEZIAWG) += amneziawg/'
	_kernel_inject_replace_block "${kernel_root}/drivers/net/Kconfig" AMNEZIAWG \
		'source "drivers/net/amneziawg/Kconfig"'
	_kernel_inject_replace_block "${kernel_root}/drivers/net/Makefile" AMNEZIAWG \
		'obj-$(CONFIG_AMNEZIAWG) += amneziawg/'

	_kernel_inject_log info "AmneziaWG" "Injected ${actual_commit} without global symbol rewriting"
}

_kernel_inject_nf_deaf() {
	local kernel_root="$1"
	local checkout="$2"
	local repository="$3"
	local ref="$4"
	local expected_commit="$5"
	local actual_commit
	local destination="${kernel_root}/net/netfilter/nf_deaf"
	local staging

	actual_commit="$(_kernel_inject_fetch "${repository}" "${ref}" "${expected_commit}" "${checkout}")"
	_kernel_inject_log debug "nf_deaf" "来源 ${repository}@${ref} -> ${actual_commit:0:12}"
	_kernel_inject_require_files "${checkout}" nf_deaf.c LICENSE

	staging="$(mktemp -d "${kernel_root}/net/netfilter/.nf_deaf.new.XXXXXX")"
	cp -a -- "${checkout}/nf_deaf.c" "${checkout}/LICENSE" "${staging}/"
	cat > "${staging}/Makefile" <<'NF_DEAF_KBUILD'
# SPDX-License-Identifier: GPL-2.0-only
obj-$(CONFIG_NETFILTER_DEAF) += nf_deaf.o
NF_DEAF_KBUILD
	cat > "${staging}/Kconfig" <<'NF_DEAF_KCONFIG'
config NETFILTER_DEAF
	tristate "Netfilter Deaf module"
	depends on NETFILTER && INET && IPV6
	help
	  Build the nf_deaf post-routing packet transformation module.
NF_DEAF_KCONFIG
	{
		printf 'repository=%s\n' "${repository}"
		printf 'ref=%s\n' "${ref}"
		printf 'commit=%s\n' "${actual_commit}"
	} > "${staging}/.source-revision"

	_kernel_inject_activate_dir "${kernel_root}" "${staging}" "${destination}"

	rm -f -- "${kernel_root}/net/netfilter/nf_deaf.c"
	_kernel_inject_remove_exact_line "${kernel_root}/net/netfilter/Makefile" \
		'obj-$(CONFIG_NETFILTER_DEAF) += nf_deaf.o'
	_kernel_inject_remove_legacy_stanza "${kernel_root}/net/netfilter/Kconfig" NETFILTER_DEAF
	_kernel_inject_replace_block "${kernel_root}/net/netfilter/Kconfig" NF_DEAF \
		'source "net/netfilter/nf_deaf/Kconfig"'
	_kernel_inject_replace_block "${kernel_root}/net/netfilter/Makefile" NF_DEAF \
		'obj-$(CONFIG_NETFILTER_DEAF) += nf_deaf/'

	_kernel_inject_log info "nf_deaf" "Injected ${actual_commit}"
}

_kernel_inject_sources() (
	# Armbian's own logging helpers intentionally read optional globals such as
	# ANSI_COLOR without default expansions, so they are not nounset-safe.
	# Keep errexit/errtrace/pipefail for the injector but explicitly disable -u
	# inside this isolated subshell, even if a caller exported/inherited it.
	set +u
	set -Eeo pipefail

	local kernel_root="$1"
	local tcp_repository="$2"
	local tcp_ref="$3"
	local tcp_commit="$4"
	local awg_repository="$5"
	local awg_ref="$6"
	local awg_commit="$7"
	local nf_repository="$8"
	local nf_ref="$9"
	local nf_commit="${10}"
	local temporary_root

	temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/armbian-kernel-inject.XXXXXX")"
	trap 'rm -rf -- "${temporary_root}"' EXIT

	_kernel_inject_tcp_brutal "${kernel_root}" "${temporary_root}/tcp-brutal" \
		"${tcp_repository}" "${tcp_ref}" "${tcp_commit}"
	_kernel_inject_amneziawg "${kernel_root}" "${temporary_root}/amneziawg" \
		"${awg_repository}" "${awg_ref}" "${awg_commit}"
	_kernel_inject_nf_deaf "${kernel_root}" "${temporary_root}/nf-deaf" \
		"${nf_repository}" "${nf_ref}" "${nf_commit}"
)

custom_kernel_config() {
	local tcp_repository="${TCP_BRUTAL_REPOSITORY:-https://github.com/HyNetworks/tcp-brutal.git}"
	# A COMMIT-only override is sufficient and becomes the default fetch ref.
	# REF remains available for servers that need a branch/tag fetch hint.
	local tcp_commit="${TCP_BRUTAL_COMMIT:-fd3e540223c8d22adbed6d1f4fc54caa623d49c0}"
	local tcp_ref="${TCP_BRUTAL_REF:-${tcp_commit}}"
	local awg_repository="${AMNEZIAWG_REPOSITORY:-https://github.com/NNdroid/amneziawg-linux-kernel-module.git}"
	local awg_commit="${AMNEZIAWG_COMMIT:-85fcc17788ed8afd929e3a4ea02edafeaa1769cc}"
	local awg_ref="${AMNEZIAWG_REF:-${awg_commit}}"
	local nf_repository="${NF_DEAF_REPOSITORY:-https://github.com/NNdroid/nf_deaf.git}"
	local nf_commit="${NF_DEAF_COMMIT:-d600e9c7f2784137348b3bbe2c94e781177e878d}"
	local nf_ref="${NF_DEAF_REF:-${nf_commit}}"
	local tcp_mode="${TCP_BRUTAL_MODE:-m}"
	local awg_mode="${AMNEZIAWG_MODE:-m}"
	local nf_mode="${NF_DEAF_MODE:-m}"
	local wireguard_mode="${WIREGUARD_MODE:-y}"
	local enable_full_ebpf="${ENABLE_FULL_EBPF:-yes}"
	local enable_full_networking="${ENABLE_FULL_NETWORKING:-yes}"
	local kernel_root

	case "${enable_full_ebpf}" in
		yes|no) ;;
		*)
			_kernel_inject_log err "Invalid configuration" \
				"ENABLE_FULL_EBPF must be yes or no, got '${enable_full_ebpf}'"
			return 1
			;;
	esac
	case "${enable_full_networking}" in
		yes|no) ;;
		*)
			_kernel_inject_log err "Invalid configuration" \
				"ENABLE_FULL_NETWORKING must be yes or no, got '${enable_full_networking}'"
			return 1
			;;
	esac
	if [[ "${enable_full_ebpf}" == yes && "${KERNEL_BTF:-yes}" == no ]]; then
		_kernel_inject_log err "Invalid configuration" \
			"ENABLE_FULL_EBPF=yes conflicts with KERNEL_BTF=no"
		return 1
	fi

	_kernel_inject_add_mode TCP_CONG_BRUTAL "${tcp_mode}" || return 1
	_kernel_inject_add_mode AMNEZIAWG "${awg_mode}" || return 1
	_kernel_inject_add_mode NETFILTER_DEAF "${nf_mode}" || return 1
	_kernel_inject_add_mode WIREGUARD "${wireguard_mode}" || return 1

	if [[ "${awg_mode}" == y && "${wireguard_mode}" == y ]]; then
		_kernel_inject_log err "Invalid built-in combination" \
			"AMNEZIAWG_MODE=y and WIREGUARD_MODE=y can collide; keep AmneziaWG as a module"
		return 1
	fi

	opts_y+=(NET INET PROC_FS CRYPTO NETFILTER IPV6 NET_SCHED)
	opts_m+=(NET_SCH_FQ)
	if [[ "${enable_full_ebpf}" == yes ]]; then
		_kernel_inject_enable_full_ebpf || return 1
	fi
	if [[ "${enable_full_networking}" == yes ]]; then
		_kernel_inject_enable_full_networking || return 1
	fi
	kernel_config_modifying_hashes+=(
		"kernel-injector-v4-package-evidence"
		"tcp-brutal=${tcp_commit:-${tcp_ref}}"
		"amneziawg=${awg_commit:-${awg_ref}}"
		"nf-deaf=${nf_commit:-${nf_ref}}"
	)

	# Armbian calls this hook once for artifact hashing without a kernel tree and
	# once from the actual kernel worktree. Configuration announcements above
	# must be identical in both phases; source injection only belongs here.
	[[ -f .config ]] || return 0
	kernel_root="$(pwd -P)"
	if [[ ! -f "${kernel_root}/net/ipv4/tcp.c" || \
		! -f "${kernel_root}/net/ipv4/Kconfig" || \
		! -f "${kernel_root}/drivers/net/Kconfig" || \
		! -f "${kernel_root}/net/netfilter/Kconfig" ]]; then
		_kernel_inject_log err "Invalid kernel tree" "Required networking sources are missing from ${kernel_root}"
		return 1
	fi

	_kernel_inject_log info "Kernel source injection" "Preparing pinned third-party modules"
	_kernel_inject_sources "${kernel_root}" \
		"${tcp_repository}" "${tcp_ref}" "${tcp_commit}" \
		"${awg_repository}" "${awg_ref}" "${awg_commit}" \
		"${nf_repository}" "${nf_ref}" "${nf_commit}"
}

# shellcheck shell=bash disable=SC2016
# Reproducible, idempotent third-party kernel source injection for Armbian.

# Pinned upstream commits. Overriding these also overrides the matching *_REF,
# and the build wrapper reads them for its post-build verification.
: "${TCP_BRUTAL_COMMIT:=fd3e540223c8d22adbed6d1f4fc54caa623d49c0}"
: "${AMNEZIAWG_COMMIT:=85fcc17788ed8afd929e3a4ea02edafeaa1769cc}"
: "${NF_DEAF_COMMIT:=d600e9c7f2784137348b3bbe2c94e781177e878d}"

_kernel_inject_log() {
	local level="$1"
	local title="$2"
	local message="$3"

	if declare -F display_alert >/dev/null 2>&1; then
		display_alert "${title}" "${message}" "${level}"
	elif [[ "${level}" == info ]]; then
		printf '[kernel-inject][%s] %s: %s\n' "${level}" "${title}" "${message}"
	else
		# debug/warn/err 一律走 stderr：这些函数常在 $( ) 里调用，写 stdout
		# 会被命令替换吞掉，甚至污染被捕获的返回值。
		printf '[kernel-inject][%s] %s: %s\n' "${level}" "${title}" "${message}" >&2
	fi
}

_kernel_inject_add_mode() {
	local symbol="$1"
	local mode="$2"

	case "${mode}" in
		y) opts_y+=("${symbol}") ;;
		m) opts_m+=("${symbol}") ;;
		*)
			_kernel_inject_log err "Invalid configuration" "${symbol} must be y or m, got '${mode}'"
			return 1
			;;
	esac
}

